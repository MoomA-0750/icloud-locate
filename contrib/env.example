# ~/.config/icloud-locate/env に置く。locate.sh と serve.sh の両方が読む
# Apple IDのパスワードは絶対に書かない（ICLOUD_PASSWORD は書いても無視される）
ICLOUD_LOCATE_APPLE_ID=your@apple.id
ICLOUD_LOCATE_DEVICE=端末の登録名
# ICLOUD_LOCATE_HOST=127.0.0.1
# ICLOUD_LOCATE_PORT=8765
# 127.0.0.1 以外（Tailscale のアドレス等）で待ち受けるときは必須
# ICLOUD_LOCATE_TOKEN_FILE=/home/you/.config/icloud-locate/token
# tailscale-serve.sh で公開する HTTPS ポート（既定 8765）
# ICLOUD_LOCATE_SERVE_PORT=8765
